# === REQUIRED ===
DATABASE_URL=sqlite:///data/test.db

# === SAFETY ===
DATABASE_READ_ONLY=true
DATABASE_WRITE_ENABLED=false
DATABASE_MAX_ROWS=1000
DATABASE_MAX_QUERY_TIME=30
DATABASE_MAX_OUTPUT_BYTES=50000

# === OPTIONAL ===
DATABASE_SAMPLE_SIZE=5
DATABASE_PROFILE_TOP_N=10

# === LLM (optional, for natural_query v2) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
